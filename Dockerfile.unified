FROM python:3.12-slim

WORKDIR /app

# Install system dependencies if any
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_unified.txt .
RUN pip install --no-cache-dir -r requirements_unified.txt

# Pre-download sentence transformer model so container startup is fast
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

# Copy project assets
COPY config/ ./config/
COPY models/bilstm/ ./models/bilstm/
COPY pipeline/routing/ ./pipeline/routing/
COPY pipeline/__init__.py ./pipeline/__init__.py
COPY app_unified.py ./app_unified.py

ENV PORT=8080
ENV MODEL_FILE=bilstm_classweight.keras

EXPOSE 8080

CMD ["sh", "-c", "uvicorn app_unified:app --host 0.0.0.0 --port ${PORT}"]
